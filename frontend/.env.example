NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# Optional: public Sepolia RPC URL accessible from the browser.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://your-public-rpc.example
# For same-origin reverse proxy deployment, set NEXT_PUBLIC_API_URL to an empty string.
# Contract addresses come only from /api/config, not legacy environment defaults.
