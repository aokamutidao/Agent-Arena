# Copy to .env.course. Never commit the resulting file.
# Generate a unique value: openssl rand -hex 32
JWT_SECRET=
DATABASE_PATH=course.db
PORT=8080
FRONTEND_PORT=3000
AUTH_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
# Empty on local direct access. In cloud, explicitly trust only your controlled proxy IP/CIDR.
TRUSTED_PROXY_CIDRS=

# Explicit local Anvil or Sepolia deployment; never use the old betting addresses.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
TOURNAMENT_MANAGER_ADDRESS=
DEPLOYMENT_BLOCK=0
CONFIRMATIONS=0
CONTRACT_ABI_DIR=../contracts/abi
POLL_INTERVAL_SECONDS=2
ROUND_INTERVAL_MS=300

# Labelled simulation is useful for a deterministic course demo.
# To use a real model, disable simulation and explicitly configure LLM_API_KEY.
# The course service never automatically loads credentials from backend/.env.
SIMULATION_ENABLED=true
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS=120
LLM_API_KEY=
# QWEN_API_KEY / QWEN_MODEL / QWEN_ENDPOINT remain explicit compatibility aliases.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# No PRIVATE_KEY or OWNER_PRIVATE_KEY belongs in the course backend.
