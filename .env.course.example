# Copy to .env.course. Never commit the resulting file.
# Generate a unique value: openssl rand -hex 32
JWT_SECRET=
DATABASE_PATH=course.db
PORT=8080
AUTH_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
# Empty on local direct access. In cloud, explicitly trust only your controlled proxy IP/CIDR.
TRUSTED_PROXY_CIDRS=

# Explicit local Anvil or Sepolia deployment; never use the old betting addresses.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
TOURNAMENT_MANAGER_ADDRESS=
DEPLOYMENT_BLOCK=0
CONFIRMATIONS=0
CONTRACT_ABI_DIR=../contracts/abi
POLL_INTERVAL_SECONDS=2
ROUND_INTERVAL_MS=300

# Labelled simulation is useful for a deterministic course demo.
# To use a real model, disable simulation and explicitly configure QWEN_API_KEY.
SIMULATION_ENABLED=true
QWEN_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# No PRIVATE_KEY or OWNER_PRIVATE_KEY belongs in the course backend.
